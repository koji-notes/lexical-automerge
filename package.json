{
  "name": "@koji/lexical-automerge",
  "version": "0.1.0",
  "description": "A small, type-safe Lexical binding for Automerge Repo documents.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/AutomergePlugin.d.ts",
      "import": "./dist/react/AutomergePlugin.js",
      "require": "./dist/react/AutomergePlugin.cjs"
    },
    "./react/AutomergePlugin": {
      "types": "./dist/react/AutomergePlugin.d.ts",
      "import": "./dist/react/AutomergePlugin.js",
      "require": "./dist/react/AutomergePlugin.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@automerge/automerge": "^2.2.9",
    "@automerge/automerge-repo": "^1.2.1",
    "@lexical/headless": "^0.20.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "lexical": "^0.20.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@lexical/code": "^0.20.2",
    "@lexical/react": "^0.20.2",
    "@lexical/rich-text": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
